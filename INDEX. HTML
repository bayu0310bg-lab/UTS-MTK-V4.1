    /**
     * =========================================================================
     * FLOATING CAMERA DRAG & DROP (TOUCH & MOUSE DENGAN BATAS LAYAR)
     * =========================================================================
     */
    (function initDraggableCamera() {
      const cam = el.floatingCam;
      let isDragging = false;
      let offsetX = 0;
      let offsetY = 0;

      function startDrag(clientX, clientY) {
        const rect = cam.getBoundingClientRect();
        isDragging = true;
        offsetX = clientX - rect.left;
        offsetY = clientY - rect.top;

        // Ubah ke positioning top/left saat mulai digeser
        cam.style.bottom = "auto";
        cam.style.right = "auto";
        cam.style.left = `${rect.left}px`;
        cam.style.top = `${rect.top}px`;
      }

      function moveDrag(clientX, clientY) {
        if (!isDragging) return;
        const margin = 8;
        const maxX = window.innerWidth - cam.offsetWidth - margin;
        const maxY = window.innerHeight - cam.offsetHeight - margin;

        let newLeft = clientX - offsetX;
        let newTop = clientY - offsetY;

        // Batasi agar tidak pernah keluar dari layar
        newLeft = Math.max(margin, Math.min(newLeft, maxX));
        newTop = Math.max(margin, Math.min(newTop, maxY));

        cam.style.left = `${newLeft}px`;
        cam.style.top = `${newTop}px`;
      }

      function endDrag() {
        isDragging = false;
      }

      // Event Mouse (Desktop)
      cam.addEventListener("mousedown", (e) => {
        e.preventDefault();
        startDrag(e.clientX, e.clientY);
      });
      window.addEventListener("mousemove", (e) => moveDrag(e.clientX, e.clientY));
      window.addEventListener("mouseup", endDrag);

      // Event Touch (HP / Tablet)
      cam.addEventListener("touchstart", (e) => {
        if (e.touches.length === 1) {
          startDrag(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      window.addEventListener("touchmove", (e) => {
        if (isDragging && e.touches.length === 1) {
          e.preventDefault();
          moveDrag(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: false });

      window.addEventListener("touchend", endDrag);

      // Pastikan kamera tetap di dalam layar saat orientasi HP berubah
      window.addEventListener("resize", () => {
        if (cam.style.left && cam.style.top) {
          const rect = cam.getBoundingClientRect();
          const margin = 8;
          const maxX = window.innerWidth - cam.offsetWidth - margin;
          const maxY = window.innerHeight - cam.offsetHeight - margin;
          cam.style.left = `${Math.max(margin, Math.min(rect.left, maxX))}px`;
          cam.style.top = `${Math.max(margin, Math.min(rect.top, maxY))}px`;
        }
      });
    })();

    /**
     * =========================================================================
     * 5. PENGUMPULAN UJIAN & INTEGRASI GOOGLE SHEETS (WEBHOOK FETCH)
     * =========================================================================
     */
    el.btnFinish.addEventListener("click", () => {
      const answeredCount = Object.keys(state.answers).length;
      const unansweredCount = QUESTIONS.length - answeredCount;
      el.confirmAnswered.textContent = answeredCount;
      el.confirmUnanswered.textContent = unansweredCount;
      el.modalConfirm.classList.remove("hidden");
    });

    el.btnCancelSubmit.addEventListener("click", () => {
      el.modalConfirm.classList.add("hidden");
    });

    el.btnConfirmSubmit.addEventListener("click", () => {
      el.modalConfirm.classList.add("hidden");
      submitExam("Selesai");
    });

    function submitExam(statusLabel) {
      if (state.examSubmitted) return;
      state.examSubmitted = true;
      state.examActive = false;

      clearInterval(state.timerInterval);
      stopSiren();
      el.modalNav.classList.add("hidden");
      el.modalConfirm.classList.add("hidden");
      el.modalWarning.classList.add("hidden");

      // Matikan kamera & mikrofon setelah selesai
      stopMediaStream();

      // Keluar dari mode Fullscreen dengan aman
      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }

      // Hitung skor maksimal 100
      let correctCount = 0;
      const detailList = QUESTIONS.map((q) => {
        const ans = state.answers[q.id] || "-";
        if (ans === q.answer) correctCount += 1;
        return `${q.id}:${ans}`;
      });

      const answeredCount = Object.keys(state.answers).length;
      const rawScore = (correctCount / QUESTIONS.length) * 100;
      const finalScore = Number.isInteger(rawScore) ? rawScore : Number(rawScore.toFixed(1));
      const waktuSubmit = new Date().toLocaleString("id-ID", {
        dateStyle: "medium",
        timeStyle: "medium"
      });

      // Tampilkan hasil di halaman Result
      const isDisqualified = statusLabel.toLowerCase().includes("diskualifikasi");
      if (isDisqualified) {
        el.resultBanner.className = "bg-red-600 text-white px-6 py-7 text-center";
        el.resultTitle.textContent = "Ujian Dihentikan!";
      } else {
        el.resultBanner.className = "bg-emerald-600 text-white px-6 py-7 text-center";
        el.resultTitle.textContent = "Ujian Selesai!";
      }

      el.resultStatusText.textContent = `Status: ${statusLabel}`;
      el.resultScore.textContent = finalScore;
      el.resNama.textContent = state.nama;
      el.resKelas.textContent = state.kelas;
      el.resAnswered.textContent = `${answeredCount} / ${QUESTIONS.length}`;
      el.resCorrect.textContent = `${correctCount} / ${QUESTIONS.length}`;
      el.resViolations.textContent = `${state.violations} kali`;
      el.resTime.textContent = waktuSubmit;

      switchView("result");

      // Susun payload untuk Google Sheets
      const payload = {
        waktu: waktuSubmit,
        nama: state.nama,
        kelas: state.kelas,
        skor: finalScore,
        status: statusLabel,
        jumlahTerjawab: `${answeredCount}/${QUESTIONS.length}`,
        detailJawaban: detailList.join(", ")
      };
      state.lastPayload = payload;

      sendToGoogleSheets(payload);
    }

    /**
     * Mengirim hasil ujian ke Google Apps Script Webhook menggunakan fetch()
     */
    async function sendToGoogleSheets(payload) {
      // Set status UI: "Mengirim data..."
      el.syncStatusBox.className = "rounded-2xl bg-blue-50 border border-blue-200 p-4 flex items-center justify-between gap-3";
      el.syncSpinner.classList.remove("hidden");
      el.syncStatusTitle.className = "text-sm font-bold text-blue-800";
      el.syncStatusTitle.textContent = "Mengirim data...";
      el.syncStatusSub.className = "text-xs text-blue-600";
      el.syncStatusSub.textContent = "Menyimpan hasil ujian ke Google Sheets";
      el.btnRetrySync.classList.add("hidden");

      // Cek apakah URL masih dummy (untuk memudahkan pengujian lokal)
      const isDummyUrl = GOOGLE_SCRIPT_URL.includes("GANTI_DENGAN_ID_APPS_SCRIPT_ANDA");

      try {
        if (isDummyUrl) {
          // Simulasi jeda jaringan jika URL dummy belum diganti
          await new Promise((resolve) => setTimeout(resolve, 1200));
          console.info("Mode Dummy Google Sheets. Payload yang siap dikirim:", payload);
        } else {
          await fetch(GOOGLE_SCRIPT_URL, {
            method: "POST",
            mode: "no-cors", // Standar untuk Google Apps Script Web App agar tidak terblokir CORS
            headers: {
              "Content-Type": "text/plain;charset=utf-8"
            },
            body: JSON.stringify(payload)
          });
        }

        // Sukses terkirim
        el.syncStatusBox.className = "rounded-2xl bg-emerald-50 border border-emerald-200 p-4 flex items-center justify-between gap-3";
        el.syncSpinner.classList.add("hidden");
        el.syncStatusTitle.className = "text-sm font-bold text-emerald-800";
        el.syncStatusTitle.textContent = "Data berhasil terkirim";
        el.syncStatusSub.className = "text-xs text-emerald-700";
        el.syncStatusSub.textContent = isDummyUrl
          ? "Simulasi berhasil (Ganti GOOGLE_SCRIPT_URL untuk koneksi Spreadsheets aktif)"
          : "Nilai dan rincian jawaban telah tercatat di Spreadsheets.";
      } catch (err) {
        console.error("Gagal mengirim ke Google Sheets:", err);
        el.syncStatusBox.className = "rounded-2xl bg-red-50 border border-red-200 p-4 flex items-center justify-between gap-3";
        el.syncSpinner.classList.add("hidden");
        el.syncStatusTitle.className = "text-sm font-bold text-red-800";
        el.syncStatusTitle.textContent = "Gagal mengirim data";
        el.syncStatusSub.className = "text-xs text-red-600";
        el.syncStatusSub.textContent = "Periksa koneksi internet Anda lalu klik Kirim Ulang.";
        el.btnRetrySync.classList.remove("hidden");
      }
    }

    el.btnRetrySync.addEventListener("click", () => {
      if (state.lastPayload) {
        sendToGoogleSheets(state.lastPayload);
      }
    });
  </script>
</body>
