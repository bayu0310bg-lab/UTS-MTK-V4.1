        }
      });
    });

    // Blokir shortcut keyboard berbahaya (F12, Ctrl+C/V/X/U/P/S, DevTools)
    document.addEventListener("keydown", (e) => {
      if (!state.examActive) return;

      const key = e.key.toLowerCase();
      const ctrlOrMeta = e.ctrlKey || e.metaKey;

      const blockedCombos =
        e.key === "F12" ||
        (ctrlOrMeta && ["c", "v", "x", "u", "p", "s", "a"].includes(key)) ||
        (ctrlOrMeta && e.shiftKey && ["i", "j", "c"].includes(key));

      if (blockedCombos) {
        e.preventDefault();
        e.stopPropagation();
        showToast("Pintasan keyboard diblokir selama ujian!");
      }
    });

    /**
     * Menangani deteksi keluar layar / pindah tab dengan DEBOUNCE
     * agar event `blur` dan `visibilitychange` tidak dihitung 2x bersamaan.
     */
    function handleLeaveScreen() {
      if (!state.examActive || state.examSubmitted) return;

      const now = Date.now();

      // Selalu pastikan sirine berbunyi saat di luar halaman
      startSiren();

      // Debounce & pengecekan status agar tidak double-count
      if (state.isOutsideScreen || now - state.lastViolationTimestamp < VIOLATION_DEBOUNCE_MS) {
        return;
      }

      state.isOutsideScreen = true;
      state.lastViolationTimestamp = now;
      state.violations += 1;

      updateStats();

      // Jika sudah mencapai 3 kali pelanggaran -> Auto-submit Diskualifikasi
      if (state.violations >= MAX_VIOLATIONS) {
        stopSiren();
        submitExam("Diskualifikasi (Curang)");
      }
    }

    /**
     * Saat siswa kembali ke halaman ujian:
     * Matikan sirine dan tampilkan peringatan jika belum didiskualifikasi.
     */
    function handleReturnToScreen() {
      if (!state.examActive || state.examSubmitted) return;

      if (state.isOutsideScreen || isSirenPlaying) {
        state.isOutsideScreen = false;
        stopSiren();

        if (state.violations > 0 && state.violations < MAX_VIOLATIONS) {
          el.warningCountText.textContent = `${state.violations} / ${MAX_VIOLATIONS}`;
          el.modalWarning.classList.remove("hidden");
        }
      }
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        handleLeaveScreen();
      } else {
        handleReturnToScreen();
      }
    });

    window.addEventListener("blur", () => {
      handleLeaveScreen();
    });

    window.addEventListener("focus", () => {
      if (!document.hidden) {
        handleReturnToScreen();
      }
    });

    el.btnAckWarning.addEventListener("click", () => {
      el.modalWarning.classList.add("hidden");
      stopSiren();
      enterFullscreen();
