<!DOCTYPE html>
<html lang="id" translate="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <!-- Mencegah fitur terjemahan otomatis browser (termasuk untuk soal bahasa asing) -->
  <meta name="google" content="notranslate" />
  <title>CBT Anti-Cheat | UTS Matematika Kelas VIII</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    /* Blokir seleksi teks dan interaksi copy-paste secara menyeluruh */
    html, body {
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
      overscroll-behavior: none;
    }

    /* Izinkan input teks hanya pada form login */
    input, select {
      -webkit-user-select: text;
      -moz-user-select: text;
      -ms-user-select: text;
      user-select: text;
    }

    /* Scrollbar halus untuk area konten soal */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Animasi denyut indikator kamera LIVE */
    @keyframes pulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }
    .live-dot {
      animation: pulseDot 1.4s infinite ease-in-out;
    }
  </style>
</head>

<body class="bg-slate-100 text-slate-800 font-sans antialiased notranslate overflow-x-hidden">

  <!-- ===================================================================== -->
  <!-- 1. HALAMAN LOGIN                                                      -->
  <!-- ===================================================================== -->
  <section id="view-login" class="min-h-[100dvh] flex items-center justify-center p-4 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-200/80 overflow-hidden">
      <!-- Header Kartu Login -->
      <div class="bg-gradient-to-r from-indigo-600 to-blue-600 px-6 py-7 text-center text-white">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/15 backdrop-blur-sm border border-white/25 mb-3 shadow-inner">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-100">Sumatif Tengah Semester Ganjil</p>
        <h1 class="text-2xl font-extrabold tracking-tight mt-1">MATEMATIKA KELAS VIII</h1>
        <p class="text-xs text-indigo-100/90 mt-1">Sistem Ujian Berbasis Komputer (CBT Anti-Cheat)</p>
      </div>

      <!-- Form Login -->
      <form id="login-form" class="p-6 sm:p-7 space-y-5" novalidate>
        <!-- Pesan Error Inline -->
        <div id="login-error" class="hidden rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-start gap-2.5">
          <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
          </svg>
          <span id="login-error-text">Mohon lengkapi semua data dengan benar.</span>
        </div>

        <!-- Input Nama Lengkap -->
        <div>
          <label for="input-nama" class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Lengkap <span class="text-red-500">*</span></label>
          <input
            type="text"
            id="input-nama"
            placeholder="Masukkan nama lengkap sesuai absen"
            autocomplete="off"
            required
            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
          />
        </div>

        <!-- Dropdown Kelas -->
        <div>
          <label for="input-kelas" class="block text-sm font-semibold text-slate-700 mb-1.5">Kelas <span class="text-red-500">*</span></label>
          <select
            id="input-kelas"
            required
            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
          >
            <option value="">-- Pilih Kelas --</option>
            <option value="8 A">8 A</option>
            <option value="8 B">8 B</option>
            <option value="8 C">8 C</option>
          </select>
        </div>

        <!-- Input Token Ujian -->
        <div>
          <label for="input-token" class="block text-sm font-semibold text-slate-700 mb-1.5">Token Ujian <span class="text-red-500">*</span></label>
          <input
            type="password"
            id="input-token"
            inputmode="numeric"
            placeholder="Masukkan token dari pengawas"
            autocomplete="off"
            required
            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm tracking-widest font-semibold text-slate-800 placeholder-slate-400 placeholder:tracking-normal placeholder:font-normal focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
          />
        </div>

        <!-- Info Ringkas -->
        <div class="grid grid-cols-3 gap-2 pt-1 text-center">
          <div class="rounded-xl bg-slate-50 border border-slate-200 p-2.5">
            <p class="text-[11px] text-slate-500 font-medium">Waktu</p>
            <p class="text-sm font-bold text-slate-800">90 Menit</p>
          </div>
          <div class="rounded-xl bg-slate-50 border border-slate-200 p-2.5">
            <p class="text-[11px] text-slate-500 font-medium">Jumlah Soal</p>
            <p id="login-total-soal" class="text-sm font-bold text-slate-800">40 PG</p>
          </div>
          <div class="rounded-xl bg-slate-50 border border-slate-200 p-2.5">
            <p class="text-[11px] text-slate-500 font-medium">Anti-Curang</p>
            <p class="text-sm font-bold text-red-600">Aktif</p>
          </div>
        </div>

        <!-- Tombol Lanjut -->
        <button
          type="submit"
          class="w-full rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-bold py-3.5 px-4 shadow-lg shadow-indigo-600/25 transition flex items-center justify-center gap-2"
        >
          <span>Lanjut ke Pemeriksaan Perangkat</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </form>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. HALAMAN PERSIAPAN (DEVICE CHECK: KAMERA & MIKROFON)                -->
  <!-- ===================================================================== -->
  <section id="view-prep" class="hidden min-h-[100dvh] flex items-center justify-center p-4 bg-slate-100">
    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
      <!-- Header Persiapan -->
      <div class="bg-slate-900 text-white px-6 py-5 flex items-center justify-between gap-3">
        <div>
          <h2 class="text-lg sm:text-xl font-bold">Pemeriksaan Perangkat & Aturan</h2>
          <p class="text-xs sm:text-sm text-slate-300 mt-0.5">Peserta: <span id="prep-student-info" class="font-semibold text-white"></span></p>
        </div>
        <button id="btn-back-login" type="button" class="text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-2 rounded-xl transition">
          Ubah Data
        </button>
      </div>

      <div class="p-5 sm:p-7 space-y-5">
        <!-- Area Preview Kamera -->
        <div class="relative rounded-2xl overflow-hidden bg-slate-900 aspect-video max-h-64 w-full flex items-center justify-center border border-slate-200 shadow-inner">
          <video id="prep-video" autoplay playsinline muted class="w-full h-full object-cover hidden transform -scale-x-100"></video>

          <!-- Placeholder sebelum izin diberikan -->
          <div id="prep-placeholder" class="text-center p-6 text-slate-400">
            <svg class="w-12 h-12 mx-auto mb-2 text-slate-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
            </svg>
            <p class="text-sm font-medium text-slate-300">Kamera & Mikrofon Belum Aktif</p>
            <p class="text-xs text-slate-400 mt-1">Klik tombol di bawah untuk mengizinkan akses perangkat.</p>
          </div>

          <!-- Status Badge di Pojok Preview -->
          <div id="prep-status-badge" class="hidden absolute top-3 left-3 bg-emerald-600/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow">
            <span class="w-2 h-2 rounded-full bg-white live-dot"></span>
            Kamera & Mikrofon Aktif
          </div>
        </div>

        <!-- Pesan Status/Error Device -->
        <div id="prep-error" class="hidden rounded-xl bg-red-50 border border-red-200 p-4 text-sm text-red-700">
          <p class="font-bold mb-1">Akses Kamera / Mikrofon Ditolak!</p>
          <p id="prep-error-text" class="text-xs leading-relaxed">Anda wajib mengizinkan kamera dan mikrofon untuk mengikuti ujian. Silakan ubah pengaturan izin di browser Anda lalu klik "Coba Aktifkan Lagi".</p>
        </div>

        <!-- Tata Tertib Anti-Curang -->
        <div class="rounded-2xl bg-amber-50 border border-amber-200/90 p-4">
          <h3 class="text-sm font-bold text-amber-900 flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            Peraturan Ketat Ujian (Anti-Cheat)
          </h3>
          <ul class="text-xs sm:text-sm text-amber-900/90 space-y-1.5 list-disc list-inside">
            <li>Ujian akan berjalan dalam mode <strong>Layar Penuh (Fullscreen)</strong>.</li>
            <li><strong>Dilarang berpindah tab</strong>, membuka aplikasi lain, atau keluar dari layar ujian.</li>
            <li>Keluar layar akan membunyikan <strong>alarm sirine</strong> dan mengurangi jatah peringatan.</li>
            <li>Batas maksimal pelanggaran adalah <strong>3 kali</strong>. Pelanggaran ke-3 otomatis <strong>Diskualifikasi (Curang)</strong>.</li>
            <li>Kamera pengawas tetap aktif selama ujian berlangsung dan dapat digeser di layar.</li>
          </ul>
        </div>

        <!-- Tombol Aksi Persiapan -->
        <div class="flex flex-col sm:flex-row gap-3">
          <button
            id="btn-request-media"
            type="button"
            class="flex-1 rounded-xl bg-slate-800 hover:bg-slate-900 active:scale-[0.99] text-white font-bold py-3.5 px-4 transition flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
            </svg>
            <span>Aktifkan Kamera & Mikrofon</span>
          </button>

          <button
            id="btn-start-exam"
            type="button"
            disabled
            class="flex-1 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:text-slate-500 disabled:cursor-not-allowed active:scale-[0.99] text-white font-bold py-3.5 px-4 shadow-lg shadow-emerald-600/20 disabled:shadow-none transition flex items-center justify-center gap-2"
          >
            <span>Mulai Ujian</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. HALAMAN UJIAN (MOBILE-FRIENDLY + STICKY HEADER & FOOTER)           -->
  <!-- ===================================================================== -->
  <section id="view-exam" class="hidden h-[100dvh] w-full flex flex-col overflow-hidden bg-slate-100">
    <!-- HEADER ATAS (TETAP) -->
    <header class="bg-slate-900 text-white px-3 sm:px-6 py-2.5 shadow-md shrink-0 z-20">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-2">
        <!-- Info Mapel & Peserta -->
        <div class="min-w-0">
          <h1 class="text-xs sm:text-base font-extrabold tracking-tight truncate">UTS MATEMATIKA VIII</h1>
          <p id="exam-student-label" class="text-[11px] sm:text-xs text-slate-300 truncate"></p>
        </div>

        <!-- Timer & Tombol Daftar Soal -->
        <div class="flex items-center gap-2 shrink-0">
          <!-- Timer 90 Menit -->
          <div id="timer-box" class="flex items-center gap-1.5 bg-slate-800 border border-slate-700 px-2.5 sm:px-3.5 py-1.5 rounded-xl">
            <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span id="exam-timer" class="font-mono text-xs sm:text-sm font-bold tracking-wider">90:00</span>
          </div>

          <!-- Tombol Popup Daftar Soal (Kanan Atas) -->
          <button
            id="btn-open-nav"
            type="button"
            class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white text-xs sm:text-sm font-bold px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl transition shadow"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
            </svg>
            <span class="hidden xs:inline">Daftar Soal</span>
            <span class="xs:hidden">Soal</span>
          </button>
        </div>
      </div>
    </header>

    <!-- SUB-HEADER INDIKATOR STATUS (TERJAWAB, BELUM, SISA PERINGATAN) -->
    <div class="bg-white border-b border-slate-200 px-3 sm:px-6 py-2 shrink-0 z-10">
      <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-2 text-[11px] sm:text-xs font-semibold">
        <div class="flex items-center gap-2 sm:gap-3">
          <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-lg">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Terjawab: <strong id="stat-answered">0</strong>
          </span>
          <span class="inline-flex items-center gap-1.5 bg-slate-100 text-slate-600 border border-slate-200 px-2.5 py-1 rounded-lg">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            Belum: <strong id="stat-unanswered">40</strong>
          </span>
        </div>

        <div id="warning-pill" class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-800 border border-amber-200 px-2.5 py-1 rounded-lg">
          <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
          Sisa Peringatan: <strong id="stat-warnings-left">3</strong>/3
        </div>
      </div>
    </div>

    <!-- AREA KONTEN SOAL (SCROLLABLE TERPISAH DARI FOOTER) -->
    <main id="question-scroll-area" class="flex-1 overflow-y-auto custom-scroll px-3 sm:px-6 py-4 sm:py-6">
      <div class="max-w-3xl mx-auto pb-8">
        <div class="bg-white rounded-2xl sm:rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-7">
          <!-- Badge Nomor & Topik -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="bg-blue-600 text-white text-xs sm:text-sm font-extrabold px-3 py-1 rounded-xl shadow-sm">
                Soal No. <span id="q-number">1</span>
              </span>
              <span class="text-xs text-slate-400 font-medium">dari <span id="q-total">40</span></span>
            </div>
            <span id="q-topic" class="text-[11px] sm:text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 px-3 py-1 rounded-full">
              Relasi dan Fungsi
            </span>
          </div>

          <!-- Teks Soal -->
          <div id="q-text" class="text-base sm:text-lg font-medium text-slate-800 leading-relaxed mb-6">
            Memuat soal...
          </div>

          <!-- Pilihan Jawaban (A, B, C, D) -->
          <div id="q-options" class="space-y-3">
            <!-- Dirender secara dinamis oleh JavaScript -->
          </div>
        </div>
      </div>
    </main>

    <!-- STICKY FOOTER NAVIGASI BAWAH -->
    <footer class="bg-white border-t border-slate-200 px-3 sm:px-6 py-3 shrink-0 shadow-[0_-4px_15px_rgba(0,0,0,0.04)] z-20">
      <div class="max-w-3xl mx-auto flex items-center justify-between gap-2 sm:gap-4">
        <!-- Tombol Sebelumnya -->
        <button
          id="btn-prev"
          type="button"
          class="flex-1 sm:flex-none sm:min-w-[140px] rounded-xl bg-slate-100 hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-bold text-xs sm:text-sm py-3 px-3 sm:px-5 transition flex items-center justify-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
          <span>Sebelumnya</span>
        </button>

        <!-- Tombol Selesai -->
        <button
          id="btn-finish"
          type="button"
          class="rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold text-xs sm:text-sm py-3 px-4 sm:px-6 shadow-md shadow-emerald-600/20 transition flex items-center justify-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span>Selesai</span>
        </button>

        <!-- Tombol Selanjutnya -->
        <button
          id="btn-next"
          type="button"
          class="flex-1 sm:flex-none sm:min-w-[140px] rounded-xl bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold text-xs sm:text-sm py-3 px-3 sm:px-5 shadow-md shadow-indigo-600/20 transition flex items-center justify-center gap-1.5"
        >
          <span>Selanjutnya</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
