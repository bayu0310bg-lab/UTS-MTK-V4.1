    /**
     * =========================================================================
     * WEB AUDIO API SIREN GENERATOR (MURNI JAVASCRIPT TANPA FILE MP3)
     * =========================================================================
     */
    let audioCtx = null;
    let sirenOsc = null;
    let sirenGain = null;
    let sirenSweepInterval = null;
    let isSirenPlaying = false;

    function initAudioContext() {
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!audioCtx && AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
        if (audioCtx && audioCtx.state === "suspended") {
          audioCtx.resume();
        }
      } catch (err) {
        console.warn("AudioContext tidak didukung:", err);
      }
    }

    function startSiren() {
      if (isSirenPlaying) return;
      try {
        initAudioContext();
        if (!audioCtx) return;

        sirenOsc = audioCtx.createOscillator();
        sirenGain = audioCtx.createGain();

        sirenOsc.type = "sawtooth";
        sirenOsc.frequency.setValueAtTime(700, audioCtx.currentTime);
        sirenGain.gain.setValueAtTime(0.22, audioCtx.currentTime);

        sirenOsc.connect(sirenGain);
        sirenGain.connect(audioCtx.destination);
        sirenOsc.start();
        isSirenPlaying = true;

        // Efek suara sirine naik-turun
        let high = true;
        sirenSweepInterval = setInterval(() => {
          if (!audioCtx || !sirenOsc) return;
          const targetFreq = high ? 1250 : 650;
          sirenOsc.frequency.linearRampToValueAtTime(targetFreq, audioCtx.currentTime + 0.35);
          high = !high;
        }, 380);
      } catch (err) {
        console.warn("Gagal membunyikan sirine:", err);
      }
    }

    function stopSiren() {
      if (!isSirenPlaying) return;
      try {
        clearInterval(sirenSweepInterval);
        sirenSweepInterval = null;
        if (sirenOsc) {
          sirenOsc.stop();
          sirenOsc.disconnect();
          sirenOsc = null;
        }
        if (sirenGain) {
          sirenGain.disconnect();
          sirenGain = null;
        }
      } catch (err) {
        console.warn("Gagal menghentikan sirine:", err);
      } finally {
        isSirenPlaying = false;
      }
    }

