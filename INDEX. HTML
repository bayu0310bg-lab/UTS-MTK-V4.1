    /**
     * =========================================================================
     * 4. LOGIKA HALAMAN UJIAN (SOAL, TIMER, NAVIGATOR POPUP, DRAGGABLE CAMERA)
     * =========================================================================
     */
    function startTimer() {
      clearInterval(state.timerInterval);
      updateTimerDisplay();

      state.timerInterval = setInterval(() => {
        if (!state.examActive || state.examSubmitted) {
          clearInterval(state.timerInterval);
          return;
        }

        state.remainingSeconds -= 1;
        updateTimerDisplay();

        if (state.remainingSeconds <= 0) {
          clearInterval(state.timerInterval);
          submitExam("Waktu Habis");
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const mins = Math.floor(Math.max(0, state.remainingSeconds) / 60);
      const secs = Math.max(0, state.remainingSeconds) % 60;
      el.examTimer.textContent = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;

      // Peringatan visual jika sisa waktu <= 5 menit
      if (state.remainingSeconds <= 300) {
        el.timerBox.classList.remove("bg-slate-800", "border-slate-700");
        el.timerBox.classList.add("bg-red-600", "border-red-500", "animate-pulse");
      }
    }

    function renderQuestion() {
      const q = QUESTIONS[state.currentIndex];
      const selectedAnswer = state.answers[q.id];

      el.qNumber.textContent = q.id;
      el.qTopic.textContent = q.topic;
      el.qText.textContent = q.question;

      // Render pilihan A, B, C, D
      el.qOptions.innerHTML = "";
      ["A", "B", "C", "D"].forEach((key) => {
        const isSelected = selectedAnswer === key;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `w-full text-left rounded-2xl border-2 p-3.5 sm:p-4 transition flex items-start gap-3 active:scale-[0.995] ${
          isSelected
            ? "border-indigo-600 bg-indigo-50/90 shadow-sm"
            : "border-slate-200 bg-white hover:border-indigo-300 hover:bg-slate-50"
        }`;

        btn.innerHTML = `
          <span class="w-8 h-8 rounded-xl shrink-0 flex items-center justify-center text-sm font-extrabold transition ${
            isSelected
              ? "bg-indigo-600 text-white"
              : "bg-slate-100 text-slate-700"
          }">${key}</span>
          <span class="text-sm sm:text-base font-medium leading-snug pt-1 ${
            isSelected ? "text-indigo-950 font-semibold" : "text-slate-700"
          }">${q.options[key]}</span>
        `;

        btn.addEventListener("click", () => {
          state.answers[q.id] = key;
          renderQuestion();
          updateStats();
        });

        el.qOptions.appendChild(btn);
      });

      // Status tombol navigasi bawah
      el.btnPrev.disabled = state.currentIndex === 0;
      el.btnNext.disabled = state.currentIndex === QUESTIONS.length - 1;

      // Scroll area soal kembali ke atas setiap pindah soal
      el.qScrollArea.scrollTo({ top: 0, behavior: "smooth" });
    }

    function updateStats() {
      const answeredCount = Object.keys(state.answers).length;
      const unansweredCount = QUESTIONS.length - answeredCount;
      const warningsLeft = Math.max(0, MAX_VIOLATIONS - state.violations);

      el.statAnswered.textContent = answeredCount;
      el.statUnanswered.textContent = unansweredCount;
      el.statWarningsLeft.textContent = warningsLeft;

      if (warningsLeft <= 1) {
        el.warningPill.className =
          "inline-flex items-center gap-1.5 bg-red-100 text-red-700 border border-red-300 px-2.5 py-1 rounded-lg font-bold";
      }
    }

    function renderNavModal() {
      el.navGrid.innerHTML = "";
      QUESTIONS.forEach((q, idx) => {
        const isCurrent = idx === state.currentIndex;
        const isAnswered = Boolean(state.answers[q.id]);

        // Aturan warna: Biru (aktif), Hijau (sudah dijawab), Putih (belum)
        let colorClasses = "bg-white text-slate-700 border-slate-300 hover:bg-slate-100";
        if (isCurrent) {
          colorClasses = "bg-blue-600 text-white border-blue-700 ring-2 ring-blue-300 shadow";
        } else if (isAnswered) {
          colorClasses = "bg-emerald-500 text-white border-emerald-600 hover:bg-emerald-600";
        }

        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = q.id;
        btn.className = `h-10 rounded-xl border font-bold text-xs sm:text-sm transition active:scale-95 ${colorClasses}`;
        btn.addEventListener("click", () => {
          state.currentIndex = idx;
          renderQuestion();
          el.modalNav.classList.add("hidden");
        });

        el.navGrid.appendChild(btn);
      });
    }

    el.btnPrev.addEventListener("click", () => {
      if (state.currentIndex > 0) {
        state.currentIndex -= 1;
        renderQuestion();
      }
    });

    el.btnNext.addEventListener("click", () => {
      if (state.currentIndex < QUESTIONS.length - 1) {
        state.currentIndex += 1;
        renderQuestion();
      }
    });

    el.btnOpenNav.addEventListener("click", () => {
      renderNavModal();
      el.modalNav.classList.remove("hidden");
    });

    el.btnCloseNav.addEventListener("click", () => {
      el.modalNav.classList.add("hidden");
