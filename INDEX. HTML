    /**
     * Memaksa masuk ke mode Fullscreen dengan penanganan Promise rejection
     */
    function enterFullscreen() {
      try {
        const docEl = document.documentElement;
        const req =
          docEl.requestFullscreen ||
          docEl.webkitRequestFullscreen ||
          docEl.msRequestFullscreen;

        if (req) {
          const promise = req.call(docEl);
          if (promise && typeof promise.catch === "function") {
            promise.catch((err) => {
              console.warn("Mode Fullscreen ditolak atau gagal:", err);
            });
          }
        }
      } catch (err) {
        console.warn("Error saat masuk Fullscreen:", err);
      }
    }

