      initAudioContext();

      // Paksa Fullscreen
      enterFullscreen();

      // Pindahkan stream video ke Floating Camera di halaman ujian
      el.examVideo.srcObject = state.mediaStream;
      el.examStudentLabel.textContent = `${state.nama} • Kelas ${state.kelas}`;

      state.examActive = true;
      state.examSubmitted = false;
      state.violations = 0;
      state.currentIndex = 0;

      switchView("exam");
      renderQuestion();
      updateStats();
