    function stopMediaStream() {
      if (state.mediaStream) {
        state.mediaStream.getTracks().forEach((track) => track.stop());
        state.mediaStream = null;
      }
      el.prepVideo.srcObject = null;
      el.prepVideo.classList.add("hidden");
      el.prepPlaceholder.classList.remove("hidden");
      el.prepStatusBadge.classList.add("hidden");
      el.btnStartExam.disabled = true;
    }

    async function requestCameraAndMic() {
      el.prepError.classList.add("hidden");

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        el.prepErrorText.textContent = "Browser Anda tidak mendukung akses Kamera/Mikrofon atau halaman tidak dibuka melalui HTTPS.";
        el.prepError.classList.remove("hidden");
        return;
      }

      try {
        el.btnRequestMedia.disabled = true;
        el.btnRequestMedia.querySelector("span").textContent = "Meminta Izin...";

        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: true
        });

        state.mediaStream = stream;
        el.prepVideo.srcObject = stream;
        el.prepVideo.classList.remove("hidden");
        el.prepPlaceholder.classList.add("hidden");
        el.prepStatusBadge.classList.remove("hidden");

        // Aktifkan tombol Mulai Ujian
        el.btnStartExam.disabled = false;
        el.btnRequestMedia.querySelector("span").textContent = "Perangkat Siap";
        showToast("Kamera dan mikrofon berhasil diaktifkan.");
      } catch (err) {
        stopMediaStream();
        el.prepErrorText.textContent =
          "Izin kamera atau mikrofon ditolak. Anda tidak dapat memulai ujian tanpa mengaktifkan keduanya. Silakan izinkan di pengaturan browser lalu coba lagi.";
        el.prepError.classList.remove("hidden");
        el.btnRequestMedia.disabled = false;
        el.btnRequestMedia.querySelector("span").textContent = "Coba Aktifkan Lagi";
      }
    }

